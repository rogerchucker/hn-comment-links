# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore Node dependencies (if you decide to add build/test tooling)
node_modules/

# Ignore build and distribution directories
dist/
build/

# Ignore packaged extensions and other archives
*.zip
*.tar.gz
*.tgz

# Ignore log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Ignore environment variable files
.env
.env.*

# Ignore editor/IDE folders
.idea/
.vscode/